# Only needed if you self-host n8n with the bundled docker-compose.yml.
# Credentials themselves are stored inside n8n, not here.

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# 32+ char random string. Encrypts stored credentials - losing it means
# re-entering every credential.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Basic auth on the editor UI.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Code node needs no extra modules for this workflow, but n8n warns without it.
NODE_FUNCTION_ALLOW_BUILTIN=

# --- Reference only: enter these in the n8n credentials UI, not here ---
# APIFY_TOKEN=apify_api_...
# OPENAI_API_KEY=sk-...
